{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui.screen 1.0",
  "x-registry": "ui.screen",
  "x-version": "1.0",
  "x-applies": "boot",
  "x-snapshot": false,
  "description": "ui::Screen (experimental): one screen of the addon: its .ui file, the flow archive it joins and the view-model path it binds.",
  "type": "object",
  "properties": {
    "file": {
      "$ref": "#/$defs/path"
    },
    "flow": {
      "description": "The flow archive the screen joins: \"flow_frontend\".",
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "anchor": {
      "description": "Where the screen opens from.",
      "type": "string"
    },
    "view_model": {
      "description": "The view-model path the screen binds.",
      "type": "string"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "ui.screen",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "file",
    "flow"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
