{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui.texture_slice 1.0",
  "x-registry": "ui.texture_slice",
  "x-version": "1.0",
  "x-applies": "boot",
  "x-snapshot": false,
  "description": "ui::TextureSlice (experimental): one named slice of one of the game's texture arrays. The core builds the BC7 slice and its mips from image and adds it to every archive that carries the array; two addons add different names to one array and both apply.",
  "type": "object",
  "properties": {
    "array": {
      "description": "The texture array, as the game's override name: \"overrides.teams.driver_select_team_logos\" (the \"overrides.\" prefix is optional and the singular driver_select_team_logo is read as the same array).",
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "description": "The slice name the UI asks for.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s#\\[\\]]+$"
    },
    "image": {
      "$ref": "#/$defs/path"
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "ui.texture_slice",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    }
  },
  "required": [
    "array",
    "name",
    "image"
  ],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
