      "type": "array",
      "items": {
        "$ref": "#/$defs/rad_upgrade"
      }
    },
    "extends": {
      "description": "Data files only: this record is a variant of that record, and its value is a merge patch on the base.",
      "type": "string",
      "x-ref": "vehicle.handling",
      "x-missing": {
        "default": "required",
        "allow": [
          "required"
        ]
      }
    },
    "edits": {
      "description": "Changes applied after the typed sections: path is section.key or section.front.key, op set, scale or add.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "enum": [
              "set",
              "scale",
              "add"
            ],
            "default": "set"
          },
          "value": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    "remove": {
      "description": "Sections the build removes, with their parts in every radUpgrade block.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [],
  "additionalProperties": true,
  "$defs": {
    "path": {
      "description": "A Path: a file or folder in the addon's folder, the game's original file (stock), or resources in an archive. null: empty.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        {
          "type": "object",
          "properties": {
            "stock": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            }
          },
          "required": [
            "stock"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "prefix": {
              "type": "string"
            },
            "kinds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "textures",
                  "materials",
                  "idf",
                  "wep"
                ]
              }
            }
          },
          "required": [
            "erp",
            "prefix",
            "kinds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "erp": {
              "type": "string",
              "pattern": "^[^/\\\\][^\\\\]*$"
            },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^eaid://"
              }
            }
          },
          "required": [
            "erp",
            "resources"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rad_upgrade": {
      "description": "cars::RadUpgrade: a named set of edits to the handling file's keys.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "op": {
                "enum": [
                  "=",
                  "+",
                  "-",
                  "*"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "section",
              "key",
              "op",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "changes"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "curve": {
      "description": "A Curve: [x, y] number pairs.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
