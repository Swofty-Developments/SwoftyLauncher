{
  "name": "two tracks that provide one venue both stay; the venue and the calendar round naming it go to the later one",
  "rule": "venue/ ids are core-owned shared ids: track.venue's track is the last enabled track in load order whose provides lists it, the earlier provider is a provider conflict and both tracks stay ok in track; with no enabled provider the venue is no_record and a fallback round resolves to the next id (dependencies.md#shared-ids, systems/tracks.md#imported-tracks)",
  "registries": {
    "track": {
      "applies": "boot"
    },
    "track.venue": {
      "applies": "boot",
      "shared": {
        "provider_registry": "track",
        "provides": "/provides",
        "resolved": "/track"
      }
    },
    "career.calendar": {
      "applies": "boot",
      "key_fields": {
        "/rounds": [
          "round"
        ]
      },
      "refs": {
        "/rounds/*/venue": "track.venue"
      }
    }
  },
