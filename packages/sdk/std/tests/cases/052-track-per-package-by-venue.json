{
  "name": "a box's entry by venue follows the venue: it names whichever venue of its chain resolves, and that venue names the track",
  "rule": "track.per_package's venue is a track.venue reference; \"a|b\" resolves to the first venue an enabled track provides, readers get the plain id, and the venue's track is its last enabled provider, so the entry's data goes to that track (systems/tracks.md#a-box-s-own-track-data, dependencies.md#when-a-reference-is-missing)",
  "registries": {
    "track": {
      "applies": "boot"
    },
    "track.venue": {
      "applies": "boot",
      "shared": {
        "provider_registry": "track",
        "provides": "/provides",
        "resolved": "/track"
      }
    },
    "content.package": {
      "applies": "content"
    },
    "track.per_package": {
      "applies": "content",
      "refs": {
        "/package": "content.package",
        "/track": "track",
        "/venue": "track.venue"
      }
    }
  },
