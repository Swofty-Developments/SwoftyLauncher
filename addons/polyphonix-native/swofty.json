{
  "schema_version": 1,
  "id": "swofty.polyphonix-native",
  "name": "PolyphoniX Native",
  "version": "0.3.0",
  "author": "Swofty",
  "icon": "icons/polyphonix-native.png",
  "description": "The PolyphoniX Native look from Assetto Corsa, by Mark Wazowski: brighter midtones, more colour, a 6000 K white balance and a soft glare with a six-point star. Sliders change live in game; B turns it on and off.",
  "license": "MIT",
  "category": "shaders",
  "experimental_features": [
    "postfx"
  ],
  "compat": {
    "game": "f1_25",
    "launcher": ">=1.7.12"
  },
  "options": [
    {
      "id": "toggle_key",
      "type": "choice",
      "label": "On/off key",
      "description": "The key that turns PolyphoniX on and off in game, while F1 25 is the window in front. None turns the key off.",
      "values": [
        "B",
        "F9",
        "F10",
        "F11",
        "Insert",
        "Home",
        "End",
        "Page Up",
        "Page Down",
        "None"
      ],
      "default": "B",
      "binds": "native"
    },
    {
      "id": "strength",
      "type": "slider",
      "label": "Look strength",
      "description": "How much of the colour look is applied, from the game's own picture at 0 to the full look at 100.",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "binds": "native"
    },
    {
      "id": "brightness",
      "type": "slider",
      "label": "Brightness",
      "description": "Lifts the midtones while white stays white. PolyphoniX uses 125; 100 leaves them as they are.",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 125,
      "binds": "native"
    },
    {
      "id": "saturation",
      "type": "slider",
      "label": "Saturation",
      "description": "The picture's colour, from grey at 0 to the game's own at 100. PolyphoniX uses 110.",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 110,
      "binds": "native"
    },
    {
      "id": "white_balance",
      "type": "slider",
      "label": "White balance (K)",
      "description": "Colour temperature: lower is warmer, 6500 is neutral. PolyphoniX uses 6000.",
      "min": 4000,
      "max": 9000,
      "step": 100,
      "default": 6000,
      "binds": "native"
    },
    {
      "id": "contrast",
      "type": "slider",
      "label": "Contrast",
      "description": "Contrast around mid grey; 100 leaves it as it is.",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100,
      "binds": "native"
    },
    {
      "id": "bloom",
      "type": "slider",
      "label": "Bloom",
      "description": "The soft glow around bright lights and sky, from none at 0.",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 35,
      "binds": "native"
    },
    {
      "id": "star",
      "type": "slider",
      "label": "Star glare",
      "description": "The six-point star on very bright lights, such as the sun on paint and glass, from none at 0.",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "binds": "native"
    },
    {
      "id": "threshold",
      "type": "slider",
      "label": "Glare threshold",
      "description": "How bright a pixel has to be to glow; lower makes more of the picture glow.",
      "min": 50,
      "max": 98,
      "step": 2,
      "default": 82,
      "binds": "native"
    }
  ],
  "postfx": [
    {
      "shader": "fx/bloom.hlsl",
      "entry": "prefilter",
      "name": "glare-bright",
      "options": [
        "{{threshold}}"
      ],
      "output": "b1"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "down",
      "name": "glare-down-2",
      "inputs": [
        "b1"
      ],
      "output": "b2"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "down",
      "name": "glare-down-3",
      "inputs": [
        "b2"
      ],
      "output": "b3"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "down",
      "name": "glare-down-4",
      "inputs": [
        "b3"
      ],
      "output": "b4"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "down",
      "name": "glare-down-5",
      "inputs": [
        "b4"
      ],
      "output": "b5"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "up",
      "name": "glare-up-4",
      "inputs": [
        "b5",
        "b4"
      ],
      "output": "u4"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "up",
      "name": "glare-up-3",
      "inputs": [
        "u4",
        "b3"
      ],
      "output": "u3"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "up",
      "name": "glare-up-2",
      "inputs": [
        "u3",
        "b2"
      ],
      "output": "u2"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "up",
      "name": "glare-up-1",
      "inputs": [
        "u2",
        "b1"
      ],
      "output": "u1"
    },
    {
      "shader": "fx/bloom.hlsl",
      "entry": "star",
      "name": "glare-star",
      "options": [
        "{{star}}"
      ],
      "inputs": [
        "b2"
      ],
      "output": "star"
    },
    {
      "shader": "fx/look.hlsl",
      "name": "look",
      "options": [
        "{{strength}}",
        "{{brightness}}",
        "{{saturation}}",
        "{{white_balance}}",
        "{{contrast}}",
        "{{bloom}}",
        "{{star}}"
      ],
      "inputs": [
        "u1",
        "star"
      ]
    }
  ],
  "postfx_toggle": "{{toggle_key}}",
  "postfx_textures": [
    {
      "name": "b1",
      "scale": 0.5,
      "format": "rgba16f"
    },
    {
      "name": "b2",
      "scale": 0.25,
      "format": "rgba16f"
    },
    {
      "name": "b3",
      "scale": 0.125,
      "format": "rgba16f"
    },
    {
      "name": "b4",
      "scale": 0.0625,
      "format": "rgba16f"
    },
    {
      "name": "b5",
      "scale": 0.03125,
      "format": "rgba16f"
    },
    {
      "name": "u4",
      "scale": 0.0625,
      "format": "rgba16f"
    },
    {
      "name": "u3",
      "scale": 0.125,
      "format": "rgba16f"
    },
    {
      "name": "u2",
      "scale": 0.25,
      "format": "rgba16f"
    },
    {
      "name": "u1",
      "scale": 0.5,
      "format": "rgba16f"
    },
    {
      "name": "star",
      "scale": 0.25,
      "format": "rgba16f"
    }
  ]
}
