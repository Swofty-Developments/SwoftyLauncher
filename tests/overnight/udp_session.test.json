{
  "schema": 1,
  "suite": "overnight.udp_session",
  "defaults": {
    "timeout_s": 480,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017",
      "swofty.classic-seasons-2016"
    ]
  },
  "tests": [
    {
      "id": "time_trial_udp_session",
      "tags": [
        "udp",
        "session"
      ],
      "fresh": true,
      "env": {
        "kind": "session",
        "mode": "time_trial",
        "box": "swofty.classic-seasons-2017/f1_2017",
        "track": "venue/albert_park"
      },
      "steps": [
        {
          "wait": {
            "event": "session.start"
          },
          "timeout_s": 180
        },
        {
          "wait": {
            "ms": 3000
          }
        },
        {
          "ai_drives_player": true
        },
        {
          "sample": {
            "read": "car[player].gearbox.gear_index",
            "every_ms": 500,
            "for_s": 30,
            "as": "gear"
          }
        }
      ],
      "assert": [
        {
          "log": "\\[udp\\] first telemetry packet rewritten",
          "min": 1
        },
        {
          "log": "\\[udp\\] stock ids on",
          "min": 1
        },
        {
          "log": "\\[udp\\] (no game import slot|sendto table)",
          "max": 0
        },
        {
          "event": "session.start",
          "min": 1
        },
        {
          "no_crash": true
        },
        {
          "series": "gear",
          "rises_by": 2
        }
      ]
    }
  ]
}
