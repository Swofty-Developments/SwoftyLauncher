{
  "schema": 1,
  "suite": "overnight.grid",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017"
    ]
  },
  "tests": [
    {
      "id": "benchmark_24_car_box",
      "tags": [
        "grid"
      ],
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 3,
        "cars": 24,
        "box": "swofty.classic-seasons-2017/f1_2017"
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 180
        },
        {
          "wait": {
            "ms": 8000
          }
        },
        {
          "read": "car[23].chassis.mass",
          "as": "m23"
        },
        {
          "read": "car[0].chassis.mass",
          "as": "m0"
        }
      ],
      "assert": [
        {
          "value": "m23",
          "between": [
            600,
            900
          ]
        },
        {
          "value": "m0",
          "between": [
            600,
            900
          ]
        },
        {
          "log": "\\[era\\] the session holds \\d+ vehicles and its vehicle table",
          "max": 0
        },
        {
          "log": "\\[tracks\\] track-facts.json: \\d+ track\\(s\\), \\d+ layer\\(s\\), grid size 2[0-9]",
          "min": 0
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "benchmark_26_car_grid",
      "tags": [
        "grid"
      ],
      "env": {
        "kind": "benchmark",
        "track": "monaco",
        "laps": 2,
        "cars": 26
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 180
        },
        {
          "wait": {
            "ms": 8000
          }
        },
        {
          "read": "car[25].chassis.mass",
          "as": "m25"
        }
      ],
      "assert": [
        {
          "value": "m25",
          "between": [
            600,
            900
          ]
        },
        {
          "no_crash": true
        }
      ]
    }
  ]
}
