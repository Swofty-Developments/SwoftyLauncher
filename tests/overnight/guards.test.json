{
  "schema": 1,
  "suite": "overnight.guards",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017"
    ]
  },
  "tests": [
    {
      "id": "boot_guards_armed",
      "tags": [
        "boot"
      ],
      "env": {
        "kind": "boot"
      },
      "timeout_s": 240,
      "steps": [
        {
          "wait": {
            "ms": 8000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[pit\\] slot guard armed",
          "min": 1
        },
        {
          "log": "\\[tyres\\] slot guard armed",
          "min": 1
        },
        {
          "log": "\\[garage\\] crew guard armed",
          "min": 1
        },
        {
          "log": "\\[era\\] session vehicle guard armed",
          "min": 1
        },
        {
          "log": "\\[era\\] setup mode guard armed",
          "min": 1
        },
        {
          "log": "\\[era\\] career id aliases armed",
          "min": 1
        },
        {
          "log": "\\[tracks\\] track select guard armed",
          "min": 1
        },
        {
          "log": "\\[career\\] standings guard armed",
          "min": 1
        },
        {
          "log": "\\[saves\\] save splice armed",
          "min": 1
        },
        {
          "log": "\\[udp\\] stock ids on",
          "min": 1
        },
        {
          "log": "\\[(pit|tyres|garage|era|tracks|career|saves)\\] [a-z ]*guard off",
          "max": 0
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "race_with_stops_no_crash",
      "tags": [
        "race"
      ],
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 6,
        "cars": 22,
        "box": "swofty.classic-seasons-2017/f1_2017"
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 120000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[pit\\] slot guard armed",
          "min": 1
        },
        {
          "log": "\\[tyres\\] slot guard armed",
          "min": 1
        },
        {
          "no_crash": true
        },
        {
          "perf": {
            "p99_ms": {
              "max": 60
            }
          }
        }
      ]
    }
  ]
}
