{
  "schema": 1,
  "suite": "overnight.tracks",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017",
      "ig11.checks"
    ]
  },
  "tests": [
    {
      "id": "guard_fits_pad",
      "tags": [
        "tracks",
        "pad-fallback"
      ],
      "fresh": true,
      "env": {
        "kind": "route",
        "routes": [
          "f1_world",
          "play"
        ]
      },
      "steps": [
        {
          "wait": {
            "screen": "f1_world_activity_container"
          },
          "timeout_s": 40
        },
        {
          "wait": {
            "ms": 3000
          }
        },
        {
          "pad": {
            "press": "right",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "screen": "solo_container",
            "settle_ms": 1500
          },
          "timeout_s": 60
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "screen": "track_select",
            "settle_ms": 1500
          },
          "timeout_s": 60
        },
        {
          "wait": {
            "ms": 3000
          }
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "ms": 10000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[tracks\\] guard: .* (fits|refused \\()",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "monaco_fuel_per_package",
      "tags": [
        "tracks"
      ],
      "env": {
        "kind": "benchmark",
        "track": "monaco",
        "laps": 5,
        "cars": 10,
        "box": "swofty.classic-seasons-2017/f1_2017"
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 20000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[tracks\\] .*track fuel not written",
          "max": 0
        },
        {
          "log": "\\[tracks\\] box fuel|fuel written",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "tracks_registries_seeded",
      "tags": [
        "tracks",
        "boot"
      ],
      "env": {
        "kind": "boot"
      },
      "steps": [
        {
          "wait": {
            "ms": 6000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[tracks\\] seeded \\d+ track row",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    }
  ]
}
