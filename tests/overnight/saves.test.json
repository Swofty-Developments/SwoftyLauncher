{
  "schema": 1,
  "suite": "overnight.saves",
  "defaults": {
    "timeout_s": 600,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017"
    ]
  },
  "tests": [
    {
      "id": "boot_launcher_saves",
      "tags": [
        "saves",
        "boot"
      ],
      "env": {
        "kind": "boot"
      },
      "steps": [
        {
          "wait": {
            "ms": 8000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[saves\\] launcher saves (are on|armed)",
          "min": 1
        },
        {
          "log": "\\[saves\\] launcher saves are off",
          "max": 0
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "career_load_writes_index",
      "tags": [
        "saves",
        "career"
      ],
      "env": {
        "kind": "career",
        "fixture": "swofty-profile-20261028",
        "at": "team_hq"
      },
      "steps": [
        {
          "wait": {
            "log": "\\[career\\] career\\.loaded"
          },
          "timeout_s": 300
        },
        {
          "wait": {
            "ms": 5000
          }
        },
        {
          "save": "now"
        },
        {
          "wait": {
            "ms": 4000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[saves\\] career .* is in the career index",
          "min": 1
        },
        {
          "log": "\\[saves\\] could not write careers/index.json",
          "max": 0
        },
        {
          "log": "\\[career\\] standings guard armed",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "career_advance_try",
      "tags": [
        "saves",
        "career",
        "known-broken"
      ],
      "env": {
        "kind": "career",
        "fixture": "swofty-profile-20261028",
        "at": "team_hq"
      },
      "steps": [
        {
          "advance": {
            "days": 7
          }
        }
      ],
      "assert": [
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "career_capture_try",
      "tags": [
        "saves",
        "career",
        "known-broken"
      ],
      "env": {
        "kind": "career",
        "fixture": "swofty-profile-20261028",
        "at": "team_hq"
      },
      "steps": [
        {
          "capture": "team_hq"
        }
      ],
      "assert": [
        {
          "no_crash": true
        }
      ]
    }
  ]
}
