{
  "schema": 1,
  "suite": "overnight.udp_pad",
  "defaults": {
    "timeout_s": 480,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017",
      "swofty.classic-seasons-2016"
    ]
  },
  "tests": [
    {
      "id": "time_trial_udp_pad",
      "tags": [
        "udp",
        "pad-fallback"
      ],
      "fresh": true,
      "env": {
        "kind": "route",
        "routes": [
          "f1_world",
          "play"
        ]
      },
      "steps": [
        {
          "wait": {
            "screen": "f1_world_activity_container"
          },
          "timeout_s": 40
        },
        {
          "wait": {
            "ms": 3000
          }
        },
        {
          "pad": {
            "press": "right",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "screen": "solo_container",
            "settle_ms": 1500
          },
          "timeout_s": 60
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "screen": "track_select",
            "settle_ms": 1500
          },
          "timeout_s": 60
        },
        {
          "pad": {
            "press": "a",
            "ms": 700,
            "retry": 2,
            "retry_after_ms": 4000
          }
        },
        {
          "wait": {
            "event": "session.start"
          },
          "timeout_s": 180
        },
        {
          "wait": {
            "ms": 4000
          }
        },
        {
          "pad": {
            "press": "a",
            "ms": 250,
            "retry": 0,
            "retry_after_ms": 4000
          }
        },
        {
          "pad": {
            "press": "a",
            "ms": 250,
            "retry": 0,
            "retry_after_ms": 4000
          }
        },
        {
          "ai_drives_player": true
        },
        {
          "sample": {
            "read": "car[player].gearbox.gear_index",
            "every_ms": 500,
            "for_s": 30,
            "as": "gear"
          }
        }
      ],
      "assert": [
        {
          "log": "\\[udp\\] first telemetry packet rewritten",
          "min": 1
        },
        {
          "log": "\\[udp\\] stock ids on",
          "min": 1
        },
        {
          "log": "\\[udp\\] (no game import slot|sendto table)",
          "max": 0
        },
        {
          "event": "session.start",
          "min": 1
        },
        {
          "no_crash": true
        },
        {
          "series": "gear",
          "rises_by": 2
        }
      ]
    }
  ]
}
