{
  "schema": 1,
  "suite": "overnight.car_physics",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "overnight.carphysics"
    ]
  },
  "tests": [
    {
      "id": "profile_layers_apply",
      "tags": [
        "physics"
      ],
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 3,
        "cars": 10
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 5000
          }
        },
        {
          "read": "car[player].brake_ecu.brake_bias",
          "as": "bias"
        },
        {
          "read": "car[player].f1_aero.total_drag",
          "as": "drag"
        },
        {
          "sample": {
            "read": "car[player].gearbox.gear_index",
            "every_ms": 500,
            "for_s": 20,
            "as": "gear"
          }
        }
      ],
      "assert": [
        {
          "log": "\\[cars\\] live car operations on: \\d+ fields",
          "min": 1
        },
        {
          "log": "\\[cars\\] car \\d+: \\d+ car\\.profile layer\\(s\\)",
          "min": 1
        },
        {
          "log": "\\[cars\\] (aero\\.lift_scale|aero\\.drag_scale|brakes\\.bias|engine\\.power_scale|engine\\.limiter_offset_rpm) off",
          "max": 0
        },
        {
          "value": "bias",
          "between": [
            0.4,
            0.7
          ]
        },
        {
          "value": "drag",
          "greater_than": 0
        },
        {
          "series": "gear",
          "rises_by": 1
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "agent_set_read_roundtrip",
      "tags": [
        "physics"
      ],
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 2,
        "cars": 6
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "set": {
            "car[player].brake_ecu.brake_bias": 0.52
          }
        },
        {
          "wait": {
            "ms": 500
          }
        },
        {
          "read": "car[player].brake_ecu.brake_bias",
          "as": "after"
        }
      ],
      "assert": [
        {
          "value": "after",
          "between": [
            0.51,
            0.53
          ]
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "off_fields_stay_off",
      "tags": [
        "physics"
      ],
      "env": {
        "kind": "benchmark",
        "track": "monaco",
        "laps": 2,
        "cars": 6
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 5000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[cars\\] car levers",
          "min": 1
        },
        {
          "log": "tyres\\.[a-z_.]*grip_scale off|fuel_modes off|refit_tyres off",
          "min": 0
        },
        {
          "no_crash": true
        }
      ]
    },
    {
      "id": "handling_record_logged",
      "tags": [
        "physics",
        "boot"
      ],
      "env": {
        "kind": "boot"
      },
      "steps": [
        {
          "wait": {
            "ms": 6000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[registry\\] vehicle\\.handling: \\d+ record\\(s\\)",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    }
  ]
}
