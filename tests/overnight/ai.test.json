{
  "schema": 1,
  "suite": "overnight.ai",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017",
      "overnight.carphysics"
    ]
  },
  "tests": [
    {
      "id": "ai_session_grip_site_armed",
      "tags": [
        "ai"
      ],
      "env": {
        "kind": "benchmark",
        "track": "bahrain",
        "laps": 4,
        "cars": 20,
        "box": "swofty.classic-seasons-2017/f1_2017"
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 90000
          }
        }
      ],
      "assert": [
        {
          "log": "\\[cars\\] car levers armed",
          "min": 1
        },
        {
          "log": "ai\\.grip_scale off",
          "max": 0
        },
        {
          "log": "\\[cars\\] car \\d+: \\d+ car\\.profile layer\\(s\\)",
          "min": 1
        },
        {
          "event": "race.start",
          "min": 1
        },
        {
          "no_crash": true
        },
        {
          "perf": {
            "p99_ms": {
              "max": 60
            }
          }
        }
      ]
    },
    {
      "id": "ai_wet_race_runs",
      "tags": [
        "ai"
      ],
      "env": {
        "kind": "benchmark",
        "track": "spa",
        "laps": 3,
        "cars": 20,
        "weather": "rain"
      },
      "steps": [
        {
          "wait": {
            "event": "race.start"
          },
          "timeout_s": 150
        },
        {
          "wait": {
            "ms": 60000
          }
        }
      ],
      "assert": [
        {
          "no_crash": true
        }
      ]
    }
  ]
}
