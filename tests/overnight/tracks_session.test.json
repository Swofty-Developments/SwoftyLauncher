{
  "schema": 1,
  "suite": "overnight.tracks_session",
  "defaults": {
    "timeout_s": 420,
    "addons": [
      "swofty.core",
      "swofty.classic-seasons",
      "swofty.classic-seasons-2017",
      "ig11.checks"
    ]
  },
  "tests": [
    {
      "id": "guard_refuses_unfit_track",
      "tags": [
        "tracks",
        "session",
        "expect-refusal"
      ],
      "env": {
        "kind": "session",
        "mode": "time_trial",
        "box": "swofty.classic-seasons-2017/f1_2017",
        "track": "venue/nurburgring"
      },
      "steps": [
        {
          "wait": {
            "event": "session.start"
          },
          "timeout_s": 60
        }
      ],
      "assert": [
        {
          "log": "\\[tracks\\] guard: .* refused \\(",
          "min": 1
        },
        {
          "no_crash": true
        }
      ]
    }
  ]
}
