# Measured against the code as it stood before it was applied: 4-space indent, braces on their own line only for
# functions, right-aligned pointers, 130 columns. clang-format 21 formats every native C and C++ source with it, except
# the vendored and generated files .clang-format-ignore lists.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 130
BreakBeforeBraces: WebKit
PointerAlignment: Right
NamespaceIndentation: None
FixNamespaceComments: false
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: All
SortIncludes: Never
IncludeBlocks: Preserve
ReflowComments: false
