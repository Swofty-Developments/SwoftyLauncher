 struct PathRasterizationSprite {
     xy_position: Point<ScaledPixels>,
     st_position: Point<f32>,
+    path_index: u32,
+}
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct PathStyle {
     color: Background,
     bounds: Bounds<ScaledPixels>,
+}
+
+fn pack_path_batch(paths: &[Path<ScaledPixels>]) -> (Vec<PathRasterizationSprite>, Vec<PathStyle>) {
+    let mut vertices = Vec::with_capacity(paths.iter().map(|p| p.vertices.len()).sum());
+    let mut styles = Vec::with_capacity(paths.len());
+    for (path_index, path) in paths.iter().enumerate() {
+        styles.push(PathStyle {
+            color: path.color,
+            bounds: path.clipped_bounds(),
+        });
+        vertices.extend(path.vertices.iter().map(|v| PathRasterizationSprite {
+            xy_position: v.xy_position,
+            st_position: v.st_position,
+            path_index: path_index as u32,
+        }));
+    }
+    (vertices, styles)
+}
+
+#[cfg(test)]
+mod compact_path_tests {
+    use super::{PathRasterizationSprite, PathStyle, pack_path_batch};
+    use gpui::Path;
+
+    #[test]
+    fn compact_path_layout_matches_hlsl_structured_buffers() {
+        assert_eq!(std::mem::size_of::<PathRasterizationSprite>(), 20);
+        assert_eq!(std::mem::offset_of!(PathRasterizationSprite, path_index), 16);
+        assert_eq!(std::mem::size_of::<PathStyle>(), 88);
+        assert_eq!(std::mem::offset_of!(PathStyle, bounds), 72);
+    }
+
+    #[test]
+    fn packing_preserves_every_vertex_style_and_clip_without_per_vertex_background_copies() {
+        let mut paths = Vec::new();
+        for i in 0..3 {
+            let mut p = Path::new(gpui::point(gpui::px(0.), gpui::px(0.)));
+            for j in 0..100 {
+                p.push_triangle(
+                    (
+                        gpui::point(gpui::px(j as f32), gpui::px(i as f32)),
+                        gpui::point(gpui::px(j as f32 + 1.), gpui::px(20.)),
+                        gpui::point(gpui::px(j as f32 + 2.), gpui::px(30.)),
+                    ),
+                    (gpui::point(0., 1.), gpui::point(0.5, 0.), gpui::point(1., 1.)),
+                );
+            }
+            p.color = gpui::hsla(i as f32 / 3., 0.6, 0.5, 0.4 + i as f32 / 5.).into();
+            paths.push(p.scale(1.5));
+        }
+        let (vertices, styles) = pack_path_batch(&paths);
+        assert_eq!(vertices.len(), 900);
+        assert_eq!(styles.len(), 3);
+        for (i, path) in paths.iter().enumerate() {
+            let style = &styles[i];
+            assert_eq!(style.color, path.color);
+            assert_eq!(style.bounds, path.clipped_bounds());
+            for (packed, original) in vertices[i * 300..(i + 1) * 300].iter().zip(&path.vertices) {
+                assert_eq!(packed.path_index as usize, i);
+                assert_eq!(packed.xy_position, original.xy_position);
+                assert_eq!(packed.st_position, original.st_position);
+            }
+        }
+        assert!(
+            vertices.len() * std::mem::size_of::<PathRasterizationSprite>()
+                + styles.len() * std::mem::size_of::<PathStyle>()
+                < vertices.len() * 104 / 4
+        );
+    }
 }
 
